 let inside=-d;let n=normalize(vec2f(boxSdf(centered+vec2f(.5,0),halfBox,radius)-boxSdf(centered-vec2f(.5,0),halfBox,radius),boxSdf(centered+vec2f(0,.5),halfBox,radius)-boxSdf(centered-vec2f(0,.5),halfBox,radius))+vec2f(.00001));
 let roll=exp(-inside/7.4);let bevel=roll*(1.-exp(-inside/1.2));
 let dis=select(24.*bevel,0.,uniforms.mode>.5);
 let samplePos=p-n*dis;let rad=mix(4.6,.75,roll);
 var c=getScene(samplePos)*.20;
 for(var j:i32=0;j<4;j=j+1){let a=f32(j)*1.5707963;let k=vec2f(cos(a),sin(a));c+=getScene(samplePos+k*rad*.48)*.11;}
 for(var j:i32=0;j<8;j=j+1){let angle=(f32(j)+.5)*.78539816;let k=vec2f(cos(angle),sin(angle))*rad;c+=getScene(samplePos+k)*.045;}
 let lit=dot(n,normalize(vec2f(-.68+uniforms.tilt*.55,-.86)));
 let fres=exp(-inside/2.4);let edge=exp(-pow((inside-1.0)/.76,2.));
 let secondary=exp(-pow((inside-4.2)/1.15,2.));
 c=mix(c,vec3f(.965,.98,1.),.145+.055*(1.-uv.y));
 c=c*(1.-.11*exp(-pow((inside-7.)/3.6,2.))*(.8-.25*lit));
 c=mix(c,vec3f(.995,1.,1.),clamp(edge*(.68+.28*lit)+secondary*(.37+.22*lit)+fres*.14,0.,.95));
 let sweep=exp(-pow((uv.x*.83+uv.y*.47-.10-uniforms.tilt*.04)/.057,2.))*(1.-smoothstep(.14,.52,uv.y));
