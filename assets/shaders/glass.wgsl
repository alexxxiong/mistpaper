fn photoPixel(p:vec2i)->vec3f {
 let c=clamp(p,vec2i(0),vec2i(287,95));let i=u32(c.y*288+c.x);
 let k=(pixels[i/6u]>>((i%6u)*5u))&31u;let v=palette[k];
 return vec3f(f32((v>>16u)&255u),f32((v>>8u)&255u),f32(v&255u))/255.;
}
fn landscape(p:vec2f)->vec3f {
 let width=nsh.size.y*3.;
 let t=fract((p.x-uniforms.phase)/(width*2.))*2.;
 let x=(1.-abs(t-1.))*288.-.5;
 let a=vec2f(x,p.y/nsh.size.y*96.-.5);let lo=vec2i(floor(a));let f=fract(a);
 return mix(mix(photoPixel(lo),photoPixel(lo+vec2i(1,0)),f.x),mix(photoPixel(lo+vec2i(0,1)),photoPixel(lo+vec2i(1,1)),f.x),f.y);
}

// Optical treatment only. The native text and inputs are painted afterwards.
fn boxSdf(v:vec2f,halfBox:vec2f,r:f32)->f32 {let q=abs(v)-halfBox+r;return length(max(q,vec2f(0)))+min(max(q.x,q.y),0.)-r;}
fn getScene(q:vec2f)->vec3f {
  let p=clamp(q,vec2f(.5),nsh.size-.5);
  if uniforms.sourceKind>1.5 {return landscape(p);}
  let probe=sample_backdrop(p/nsh.size);
  if uniforms.sourceKind<.5 && probe.a<.02 {return landscape(p);}
  return probe.rgb;
}
fn shade(uv:vec2f)->vec4f {
